+import type { DbExecutor } from '../db/contracts.ts';
+import { registrarEventoHistorico } from '../clientes/repositories/historico.repository.ts';
+import { perdaSchema, type Alvo } from './modelo.ts';
+
+/** Chamador trava o alvo, prova o tenant e valida o cancelamento antes de entrar aqui. */
+export async function gravarPerda(tx: DbExecutor, empresaId: string, usuarioId: string, alvo: Alvo, clienteId: string, entrada: unknown) {
+  const perda = perdaSchema.parse(entrada);
+  const tabela = alvo.tipo === 'CONTATO' ? 'marketing_contatos' : 'fechamentos';
+  await tx.query(`UPDATE ${tabela} SET perda_motivo=$3, perda_observacao=$4, perdida_em=clock_timestamp() WHERE empresa_id=$1::uuid AND id=$2::uuid`,
+    [empresaId, alvo.id, perda.motivo, perda.observacao || null]);
+  await tx.query(`UPDATE oportunidades_acoes SET encerrada_em=clock_timestamp(),resultado='PERDIDA'
+    WHERE empresa_id=$1::uuid AND ${alvo.tipo === 'CONTATO' ? 'contato_id' : 'fechamento_id'}=$2::uuid AND encerrada_em IS NULL`, [empresaId, alvo.id]);
+  await registrarEventoHistorico({ clienteId, usuarioId, tipoEvento: 'OPORTUNIDADE_PERDIDA', origem: 'CRM_INTERNO',
+    entidadeTipo: alvo.tipo, entidadeId: alvo.id, detalhe: perda.motivo, metadata: { motivo: perda.motivo, observacao: perda.observacao || null } }, tx);
+}
diff --git a/lib/oportunidades/resumo.ts b/lib/oportunidades/resumo.ts
new file mode 100644
index 00000000..146fd242
--- /dev/null
+++ b/lib/oportunidades/resumo.ts
@@ -0,0 +1,57 @@
+import type { DbExecutor } from '../db/contracts.ts';
+import type { EnviarEmail, MensagemEmail } from '../acessos/email.ts';
+import { withTenantTransaction } from '../saas/provar-tenant.ts';
+import { hojeSaoPaulo } from '../marketing/utm.ts';
+import { listarOportunidades } from './consultas.ts';
+import type { Oportunidade } from './modelo.ts';
+import { exigirRecursoPlano } from '../assinatura/recursos-plano.ts';
+import { exigirCapacidadeMarketing } from '../marketing/capacidades.ts';
+
+type Transacao = <T>(work:(tx:DbExecutor)=>Promise<T>)=>Promise<T>;
+export function mensagemResumo(para:string,empresaId:string,usuarioId:string,hoje:string,itens:Oportunidade[],empresaNome:string):MensagemEmail {
+  const texto=`iA.Fest — ${empresaNome} — ações para ${hoje.split('-').reverse().join('/')}\n\n`+itens.map(i=>`${i.proxima!.data<hoje?'Atrasada':'Hoje'} · ${i.proxima!.tipo} · ${i.nome} · ${i.proxima!.data}`).join('\n')+'\n\nConfira os próximos passos em Oportunidades no painel.';
+  return {para,assunto:`iA.Fest · ${empresaNome}: suas ações de hoje`,texto,html:'<pre>'+texto.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')+'</pre>',idempotencia:`oportunidades/${empresaId}/${usuarioId}/${hoje}`};
+}
+/** Só faz consultas se a chave estiver explicitamente ligada. Provedor é injetável, como nos demais e-mails. */
+export async function enviarResumosDiarios(deps:{transacao:Transacao;enviar:EnviarEmail;env:Record<string,string|undefined>;tenant?:typeof withTenantTransaction}) {
+  if (deps.env.OPORTUNIDADES_RESUMO_EMAIL!=='true') return {desligado:true,enviados:0,falhas:0};
+  const hoje=hojeSaoPaulo(),tenantTx=deps.tenant??withTenantTransaction;
+  const candidatos=await deps.transacao(async tx=>(await tx.query<{empresa_id:string;usuario_id:string}>(`SELECT DISTINCT a.empresa_id::text,(CASE WHEN a.fechamento_id IS NOT NULL THEN f.usuario_responsavel_id ELSE a.responsavel_id END)::text AS usuario_id
+    FROM oportunidades_acoes a JOIN empresas e ON e.id=a.empresa_id AND e.status='ATIVA'
+    LEFT JOIN fechamentos f ON f.empresa_id=a.empresa_id AND f.id=a.fechamento_id
+    WHERE a.encerrada_em IS NULL AND a.data<=$1::date
+    AND (CASE WHEN a.fechamento_id IS NOT NULL THEN f.usuario_responsavel_id ELSE a.responsavel_id END) IS NOT NULL ORDER BY 1,2`,[hoje])).rows);
+  let enviados=0,falhas=0;
+  for (const c of candidatos) {
+    try {
+      const sessao={usuario_id:c.usuario_id,empresa_ativa_id:c.empresa_id,papel:'ADMINISTRATIVO'};
+      await tenantTx(sessao,null,async(tx,tenant)=>{
+        await exigirRecursoPlano(tx,tenant.empresaComprovada,'MARKETING');
+        await exigirCapacidadeMarketing(tx,tenant,'MARKETING_VISUALIZAR');
+        const u=(await tx.query<{email:string}>('SELECT email FROM usuarios_administrativos WHERE id=$1::uuid AND ativo',[tenant.usuarioId])).rows[0];
+        if (!u) return;
+        const itens=(await listarOportunidades(tx,tenant.empresaComprovada,tenant.usuarioId)).filter(i=>i.proxima&&i.proxima.data<=hoje);
+        if (!itens.length) return;
+        const empresa=(await tx.query<{nome:string}>('SELECT nome FROM empresas WHERE id=$1::uuid',[tenant.empresaComprovada])).rows[0];
+        const mensagem=mensagemResumo(u.email,tenant.empresaComprovada,tenant.usuarioId,hoje,itens,empresa.nome);
+        const acoes=itens.map(i=>i.proxima!.id).sort();
+        await tx.query(`INSERT INTO oportunidades_resumos(empresa_id,usuario_id,dia,mensagem) VALUES($1::uuid,$2::uuid,$3::date,$4::jsonb) ON CONFLICT DO NOTHING`,[tenant.empresaComprovada,tenant.usuarioId,hoje,JSON.stringify({mensagem,acoes})]);
+      });
+      // Fotografia já persistida: chave e conteúdo são os mesmos mesmo se o processo cair após o aceite do provedor.
+      await tenantTx(sessao,null,async(tx,tenant)=>{
+        await exigirRecursoPlano(tx,tenant.empresaComprovada,'MARKETING');
+        await exigirCapacidadeMarketing(tx,tenant,'MARKETING_VISUALIZAR');
+        const registro=(await tx.query<{mensagem:{mensagem:MensagemEmail;acoes:string[]};estado:string}>('SELECT mensagem,estado FROM oportunidades_resumos WHERE empresa_id=$1::uuid AND usuario_id=$2::uuid AND dia=$3::date FOR UPDATE',[tenant.empresaComprovada,tenant.usuarioId,hoje])).rows[0];
+        if (!registro || registro.estado!=='PENDENTE') return;
+        const itens=(await listarOportunidades(tx,tenant.empresaComprovada,tenant.usuarioId)).filter(i=>i.proxima&&i.proxima.data<=hoje);
+        const email=(await tx.query<{email:string}>('SELECT email FROM usuarios_administrativos WHERE id=$1::uuid AND ativo',[tenant.usuarioId])).rows[0]?.email;
+        let estado='OBSOLETO';
+        if (email===registro.mensagem.mensagem.para && JSON.stringify(itens.map(i=>i.proxima!.id).sort())===JSON.stringify(registro.mensagem.acoes)) {
+          try {await deps.enviar(registro.mensagem.mensagem);estado='ENVIADO';enviados++;} catch {estado='FALHOU';falhas++;}
+        }
+        await tx.query("UPDATE oportunidades_resumos SET estado=$4,enviado_em=CASE WHEN $4='ENVIADO' THEN clock_timestamp() END WHERE empresa_id=$1::uuid AND usuario_id=$2::uuid AND dia=$3::date",[tenant.empresaComprovada,tenant.usuarioId,hoje,estado]);
+      });
+    } catch {falhas++;}
+  }
+  return {desligado:false,enviados,falhas};
+}
diff --git a/lib/oportunidades/service.ts b/lib/oportunidades/service.ts
new file mode 100644
index 00000000..5f5c0341
--- /dev/null
+++ b/lib/oportunidades/service.ts
@@ -0,0 +1,87 @@
+import type { DbExecutor } from '../db/contracts.ts';
+import { registrarEventoHistorico } from '../clientes/repositories/historico.repository.ts';
+import { registrarAuditoria } from '../clientes/repositories/auditoria.repository.ts';
+import { buscarRevisaoDaVersao } from '../fechamentos/repositories/revisao.repository.ts';
+import { cancelarPreparacao } from '../fechamentos/services/revisao-operacional.service.ts';
+import { travarConfiguracaoAgenda } from '../agenda/trava-configuracao.ts';
+import { clienteDoContato } from '../marketing/contatos.ts';
+import { conflito, MarketingError, naoEncontrado } from '../marketing/erros.ts';
+import { gravarPerda } from './perda.ts';
+import { comandoSchema, etapaDoEstado, type Alvo, type Comando } from './modelo.ts';
+
+export async function exigirSchema(tx: DbExecutor) {
+  if (!(await tx.query<{ ok: boolean }>("SELECT to_regclass('public.oportunidades_acoes') IS NOT NULL AS ok")).rows[0]?.ok)
+    throw new MarketingError('OPORTUNIDADES_INDISPONIVEIS', 'Oportunidades indisponíveis neste ambiente.', 503);
+}
+
+export async function clienteDoAlvo(tx: DbExecutor, empresaId: string, alvo: Alvo) {
+  const contato = alvo.tipo === 'CONTATO';
+  const r = (await tx.query<{ cliente_id: string | null; status: string; nome?: string; telefone?: string | null; email?: string | null }>(
+    `SELECT cliente_id::text,status${contato ? ',nome,telefone,email' : ''} FROM ${contato ? 'marketing_contatos' : 'fechamentos'} WHERE empresa_id=$1::uuid AND id=$2::uuid FOR UPDATE`, [empresaId, alvo.id])).rows[0];
+  if (!r) naoEncontrado();
+  if (!r.cliente_id && contato) {
+    const cliente = await clienteDoContato(tx, empresaId, { nome: r.nome!, telefone: r.telefone ?? null, email: r.email ?? null });
+    r.cliente_id = cliente.clienteId;
+    await tx.query("UPDATE marketing_contatos SET cliente_id=$3::uuid,vinculo_cliente='MANUAL' WHERE empresa_id=$1::uuid AND id=$2::uuid", [empresaId, alvo.id, r.cliente_id]);
+  }
+  if (!r.cliente_id) throw new MarketingError('OPORTUNIDADE_SEM_CLIENTE', 'Vincule a negociação a um cliente primeiro.', 409);
+  return r as typeof r & { cliente_id: string };
+}
+
+export async function executarOportunidade(tx: DbExecutor, empresaId: string, usuarioId: string, entrada: Comando, gestao: boolean, membershipId?: string) {
+  const cmd = comandoSchema.parse(entrada);
+  await exigirSchema(tx);
+  if (cmd.acao==='perder' && cmd.alvo.tipo==='FECHAMENTO') await travarConfiguracaoAgenda(tx,empresaId,{modo:'COMPARTILHADA',linha:'JA_TRAVADA'});
+  const atual = await clienteDoAlvo(tx, empresaId, cmd.alvo);
+  if (!etapaDoEstado(atual.status, cmd.alvo.tipo === 'CONTATO')) conflito('Esta oportunidade já foi encerrada. Atualize a tela.');
+  if (cmd.alvo.tipo === 'CONTATO' && (await tx.query(`SELECT 1 FROM marketing_contatos k WHERE k.empresa_id=$1::uuid AND k.id=$2::uuid AND
+    k.fechamento_id IS NOT NULL`, [empresaId,cmd.alvo.id])).rows.length)
+    conflito('Este contato já tem negociação. Abra a negociação.');
+  const coluna = cmd.alvo.tipo === 'CONTATO' ? 'contato_id' : 'fechamento_id';
+  const aberta = (await tx.query<{ id: string }>(`SELECT id::text FROM oportunidades_acoes WHERE empresa_id=$1::uuid AND ${coluna}=$2::uuid AND encerrada_em IS NULL FOR UPDATE`, [empresaId,cmd.alvo.id])).rows[0];
+  if ((aberta?.id ?? null) !== cmd.esperada) conflito('A próxima ação mudou. Atualize a tela antes de salvar.');
+  if (cmd.acao === 'perder') {
+    if (cmd.alvo.tipo === 'FECHAMENTO') {
+      if (!gestao) throw new MarketingError('OPORTUNIDADE_SEM_PERMISSAO','Somente a Gestão pode cancelar a negociação.',403);
+      if (['CONTRATO_ASSINADO','AGUARDANDO_PAGAMENTO'].includes(atual.status)) conflito('Use o cancelamento de contrato na tela do contrato.');
+      // O fluxo contratual existente preserva preparação, assinaturas e financeiro; nunca o contornar.
+      const contrato = (await tx.query<{id: string; status: string}>('SELECT id::text,status FROM contratos WHERE fechamento_id=$1::uuid FOR UPDATE',[cmd.alvo.id])).rows[0];
+      if (contrato) {
+        const fluxo = (await tx.query<{versao_vigente_id: string | null; versao_em_preparacao_id: string | null}>('SELECT * FROM contrato_fluxos WHERE contrato_id=$1::uuid FOR UPDATE',[contrato.id])).rows[0];
+        if (contrato.status!=='AGUARDANDO_ASSINATURA' || fluxo?.versao_vigente_id) conflito('Use o cancelamento da Festa para este contrato.');
+        if (!(await tx.query("SELECT 1 FROM festa_membership_capacidades WHERE membership_id=$1::uuid AND empresa_id=$2::uuid AND capacidade='FESTA_CORRIGIR' AND revogado_em IS NULL",[membershipId ?? null,empresaId])).rows.length)
+          throw new MarketingError('OPORTUNIDADE_SEM_PERMISSAO','Somente a Gestão com acesso ao contrato pode cancelar a contratação.',403);
+        if ((await tx.query("SELECT 1 FROM contrato_assinaturas WHERE contrato_versao_id IN (SELECT id FROM contrato_versoes WHERE contrato_id=$1::uuid) AND parte='CLIENTE' LIMIT 1",[contrato.id])).rows.length ||
+          (await tx.query('SELECT 1 FROM festas WHERE contrato_id=$1::uuid UNION ALL SELECT 1 FROM pagamentos p JOIN contrato_versoes v ON v.id=p.contrato_versao_id WHERE v.contrato_id=$1::uuid LIMIT 1',[contrato.id])).rows.length)
+          conflito('Há assinatura, Festa ou plano financeiro. Use o fluxo de cancelamento do contrato.');
+        const preparacao = fluxo?.versao_em_preparacao_id ? await buscarRevisaoDaVersao(fluxo.versao_em_preparacao_id,tx,true) : null;
+        if (preparacao && ['EM_ELABORACAO','CONGELADA'].includes(preparacao.estado)) await cancelarPreparacao(tx,preparacao,{usuarioId,requestId:null,ip:null,userAgent:null},cmd.perda.motivo);
+        await tx.query("UPDATE contratos SET status='CANCELADO',cancelado_em=clock_timestamp() WHERE id=$1::uuid",[contrato.id]);
+        await registrarAuditoria({clienteId:atual.cliente_id,usuarioId,atorTipo:'USUARIO',acao:'CONTRATO_CANCELADO_ANTES_DA_FORMALIZACAO',entidadeTipo:'CONTRATO',entidadeId:contrato.id,dadosDepois:{motivo:cmd.perda.motivo},origem:'CRM_INTERNO'},tx);
+      }
+    }
+    if (cmd.concluir && aberta) await concluirAcao(tx,empresaId,usuarioId,atual.cliente_id,cmd.alvo,aberta.id);
+    await tx.query(`UPDATE ${cmd.alvo.tipo === 'CONTATO' ? 'marketing_contatos' : 'fechamentos'} SET status=$3 WHERE empresa_id=$1::uuid AND id=$2::uuid`,[empresaId,cmd.alvo.id,cmd.alvo.tipo === 'CONTATO' ? 'DESCARTADO' : 'CANCELADO']);
+    await gravarPerda(tx,empresaId,usuarioId,cmd.alvo,atual.cliente_id,cmd.perda);
+    return { perdida: true };
+  }
+  const responsavel = await tx.query(`SELECT 1 FROM memberships m JOIN usuarios_administrativos u ON u.id=m.usuario_id
+    WHERE m.empresa_id=$1::uuid AND m.usuario_id=$2::uuid AND m.status='ATIVA' AND u.ativo
+    AND (m.papel='REPRESENTANTE_AUTORIZADO' OR EXISTS(SELECT 1 FROM marketing_membership_capacidades cap WHERE cap.empresa_id=m.empresa_id AND cap.membership_id=m.id AND cap.revogado_em IS NULL))
+    FOR SHARE OF m,u`,[empresaId,cmd.proxima.responsavelId]);
+  if (!responsavel.rows.length) naoEncontrado('Responsável indisponível nesta empresa.');
+  if (aberta) {
+    if (cmd.acao === 'concluir') await concluirAcao(tx,empresaId,usuarioId,atual.cliente_id,cmd.alvo,aberta.id);
+    else await tx.query("UPDATE oportunidades_acoes SET encerrada_em=clock_timestamp(),resultado='SUBSTITUIDA' WHERE empresa_id=$1::uuid AND id=$2::uuid",[empresaId,aberta.id]);
+  }
+  const nova = (await tx.query<{ id: string }>(`INSERT INTO oportunidades_acoes(empresa_id,${coluna},responsavel_id,tipo,data,observacao,criada_por)
+    VALUES($1::uuid,$2::uuid,$3::uuid,$4,$5::date,$6,$7::uuid) RETURNING id::text`,[empresaId,cmd.alvo.id,cmd.proxima.responsavelId,cmd.proxima.tipo,cmd.proxima.data,cmd.proxima.observacao || null,usuarioId])).rows[0];
+  await tx.query(`UPDATE ${cmd.alvo.tipo === 'CONTATO' ? 'marketing_contatos' : 'fechamentos'} SET ${cmd.alvo.tipo === 'CONTATO' ? 'responsavel_id' : 'usuario_responsavel_id'}=$3::uuid WHERE empresa_id=$1::uuid AND id=$2::uuid`,[empresaId,cmd.alvo.id,cmd.proxima.responsavelId]);
+  await registrarEventoHistorico({clienteId:atual.cliente_id,usuarioId,tipoEvento:'OPORTUNIDADE_PROXIMA_ACAO',origem:'CRM_INTERNO',entidadeTipo:cmd.alvo.tipo,entidadeId:cmd.alvo.id,
+    metadata:{anteriorId:aberta?.id ?? null,acaoId:nova.id,...cmd.proxima}},tx);
+  return { id: nova.id };
+}
+async function concluirAcao(tx: DbExecutor,empresaId: string,usuarioId: string,clienteId: string,alvo: Alvo,id: string) {
+  await tx.query("UPDATE oportunidades_acoes SET encerrada_em=clock_timestamp(),resultado='FEITA' WHERE empresa_id=$1::uuid AND id=$2::uuid",[empresaId,id]);
+  await registrarEventoHistorico({clienteId,usuarioId,tipoEvento:'OPORTUNIDADE_ACAO_FEITA',origem:'CRM_INTERNO',entidadeTipo:alvo.tipo,entidadeId:alvo.id,metadata:{acaoId:id}},tx);
+}
diff --git a/scripts/migration-122-comum.cjs b/scripts/migration-122-comum.cjs
new file mode 100644
index 00000000..660e6599
--- /dev/null
+++ b/scripts/migration-122-comum.cjs
@@ -0,0 +1,65 @@
+/* eslint-disable @typescript-eslint/no-require-imports */
+// Aplicador manual: hash revisado, alvo dos adaptadores existentes, conferência READ ONLY,
+// marcador exclusivo no disco persistente e precheck → migration → postcheck → COMMIT.
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const {lerRevisado}=require('./migration-092-094-comum.cjs');
+const {commitNaFalha}=require('./migration-118-comum.cjs');
+const HASHES=require('./migration-122-hashes.json');
+const arquivos=['database/checks/20261114_122_precheck.sql','database/migrations/20261114_122_oportunidades.sql','database/checks/20261114_122_postcheck.sql'];
+const raiz=path.resolve(__dirname,'..');
+function corpos(){return arquivos.map((a,i)=>lerRevisado(raiz,a,HASHES[i]));}
+function modo(argv){
+ if(!argv.length)return 'plano';
+ if(argv.length===1&&argv[0]==='--conferir-122')return 'conferir';
+ if(argv.length===3&&argv[0]==='--aplicar-122-autorizado'&&argv[1]==='--backup'&&/^[A-Za-z0-9:._/ -]{6,120}$/.test(argv[2]))return 'aplicar';
+ throw Error('ARGUMENTOS_OU_BACKUP_RECUSADOS');
+}
+const SQL_ESTADO=`SELECT to_regclass('public.oportunidades_acoes') IS NOT NULL AS a,
+ to_regclass('public.oportunidades_marcos') IS NOT NULL AS m,to_regclass('public.oportunidades_resumos') IS NOT NULL AS r,
+ EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='fechamentos' AND column_name='perdida_em') AS f,
+ EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='marketing_contatos' AND column_name='perdida_em') AS c`;
+function estado(linha){const n=Object.values(linha).filter(Boolean).length;if(n===0)return 'ausente';if(n===5)return 'presente';throw Error('ESTADO_PARCIAL');}
+function corpo(sql){return sql.split(/\r?\n/).filter(l=>!/^\s*(BEGIN|COMMIT);\s*$/i.test(l)).join('\n');}
+async function privilegios(db){
+ const l=(await db.query(`SELECT has_schema_privilege(current_user,'public','USAGE') AS uso,
+ has_schema_privilege(current_user,'public','CREATE') AS criar,
+ (SELECT bool_and(pg_has_role(current_user,c.relowner,'MEMBER')) FROM pg_class c WHERE c.oid IN ('public.fechamentos'::regclass,'public.marketing_contatos'::regclass)) AS dono,
+ has_table_privilege(current_user,'public.empresas','REFERENCES') AND has_table_privilege(current_user,'public.usuarios_administrativos','REFERENCES') AS referencias`)).rows[0];
+ assert.ok(l?.uso&&l?.criar&&l?.dono&&l?.referencias,'PRIVILEGIOS_INSUFICIENTES');
+}
+function criarAplicador(amb){
+ async function conferirCliente(db,env){
+  await db.query('BEGIN TRANSACTION READ ONLY');
+  try{await db.query("SET LOCAL lock_timeout='5s'");amb.identidade((await db.query(amb.SQL_IDENTIDADE)).rows[0],env);await privilegios(db);
+   const s=estado((await db.query(SQL_ESTADO)).rows[0]),sql=corpos();await db.query(corpo(s==='ausente'?sql[0]:sql[2]));await db.query('COMMIT');return s;
+  }catch(e){await db.query('ROLLBACK').catch(()=>{});throw e;}
+ }
+ async function principal(argv,env,deps={}){
+  const m=modo(argv),sql=corpos();
+  if(m==='plano')return {codigo:0,saida:{resultado:'PLANO',conecta:false,ambiente:amb.nome,arquivos:arquivos.map((arquivo,i)=>({arquivo,sha256:HASHES[i]}))}};
+  const cfg=amb.alvo(env),Client=deps.Client??require('pg').Client;
+  const db=new Client(cfg);let registro=null,arquivo=null,commit='NAO_COMMITADA',etapa='CONECTAR';
+  try{await db.connect();const s=await conferirCliente(db,env);
+   if(m==='conferir')return {codigo:0,saida:{resultado:s==='presente'?'JA_APLICADA_POSTCHECK_PASS':'PRONTA_PARA_APLICAR'}};
+   assert.equal(s,'ausente','JA_PRESENTE_NAO_REAPLICAR');amb.exigirDisco();
+   fs.mkdirSync(amb.DIR,{recursive:true,mode:0o700});arquivo=path.join(amb.DIR,'migration-122.json');
+   const inicial={ambiente:amb.nome,inicio:new Date().toISOString(),backup:argv[2],etapa:'INICIADA',commit};
+   fs.writeFileSync(arquivo,JSON.stringify(inicial),{flag:'wx',mode:0o600});registro=inicial;
+   await db.query('BEGIN');await db.query("SET LOCAL lock_timeout='5s'; SET LOCAL statement_timeout='60s'");
+   amb.identidade((await db.query(amb.SQL_IDENTIDADE)).rows[0],env);await privilegios(db);
+   for(let i=0;i<sql.length;i++){etapa=['PRECHECK','MIGRATION','POSTCHECK'][i];await db.query(corpo(sql[i]));}
+   etapa='COMMIT';const r=await db.query('COMMIT');assert.notEqual(r.command,'ROLLBACK','COMMIT_RESPONDEU_ROLLBACK');commit='CONFIRMADO';
+   etapa='RECONFERIR';await conferirCliente(db,env);registro={...registro,etapa:'PASS',commit};fs.writeFileSync(arquivo,JSON.stringify(registro));return {codigo:0,saida:{resultado:'APLICADA_POSTCHECK_PASS',commit}};
+  }catch(e){if(etapa==='COMMIT')commit=commitNaFalha(e);await db.query('ROLLBACK').catch(()=>{});
+   const saida={resultado:'RECUSADA_OU_FALHA',etapa,commit,codigoSql:/^[A-Z0-9]{5}$/.test(e.code??'')?e.code:null};
+   // Não ecoa mensagens do driver: podem conter credencial ou dado comercial.
+   if(registro&&arquivo)try{fs.writeFileSync(arquivo,JSON.stringify({...registro,...saida}));}catch{saida.marcadorDesatualizado=true;}
+   return {codigo:registro?2:1,saida};
+  }finally{await db.end().catch(()=>{});}
+ }
+ function cli(){principal(process.argv.slice(2),process.env).then(r=>{console.log(JSON.stringify(r.saida));process.exitCode=r.codigo;}).catch(()=>{console.error('RECUSADO_ANTES_DE_CONECTAR');process.exitCode=1;});}
+ return {principal,cli,conferirCliente};
+}
+module.exports={criarAplicador,modo,corpo,SQL_ESTADO,estado,arquivos};
