# =====================================================================================================================
# CONFIGURAÇÃO DE HOMOLOGAÇÃO — VALORES SINTÉTICOS — SOMENTE STAGING (kidmais-manager-staging, srv-daif418ae00c73e8k2gg)
#
# NÃO É POLÍTICA COMERCIAL. Prazos e preços abaixo existem só para o ensaio caber em poucos dias e para o checkout do
# Asaas SANDBOX ter um valor. Nenhum deles foi decidido por Felipe (§8 de docs/HOMOLOGACAO_VENDA_STAGING_20261007.md).
# Nunca copiar este arquivo para production. Os segredos NÃO estão aqui: são colados por Felipe direto no campo
# Environment do serviço de staging (Render), nunca em chat, arquivo ou commit.
#
# Conferido por lib/assinatura/configuracao-homologacao.test.ts com os mesmos validadores da aplicação.
# Aplicar = uma única gravação no Environment de staging (redeploy do mesmo commit), com autorização própria.
# Reverter = apagar as variáveis deste bloco (o código volta aos padrões propostos e às funções desligadas).
# =====================================================================================================================

# --- Prazos do ensaio (sintéticos; padrões propostos: 15 / 7 / 60) ---------------------------------------------------
ASSINATURA_TESTE_DIAS=1
ASSINATURA_REGULARIZACAO_DIAS=1
ASSINATURA_SOMENTE_LEITURA_DIAS=1

# --- Preços de teste do sandbox (sintéticos; sem significado comercial; centavos) -------------------------------------
ASSINATURA_PRECO_MENSAL_CENTAVOS=990
ASSINATURA_PRECO_ANUAL_CENTAVOS=9900

# --- Cobrança: SOMENTE sandbox (o código recusa qualquer outro ambiente) -----------------------------------------------
ASAAS_AMBIENTE=sandbox
# ASAAS_API_KEY=<segredo: chave $aact_hmlg_ da conta sandbox — colar no Render>
# ASAAS_WEBHOOK_TOKEN=<segredo: 32–255 caracteres gerados no terminal de Felipe — colar no Render e no webhook do sandbox>

# --- E-mail controlado (Resend com subdomínio verificado; só caixas controladas por Felipe) ----------------------------
EMAIL_PROVIDER=resend
# Trocar o domínio .invalid pelo subdomínio verificado no Resend no momento de colar (o .invalid nunca entrega).
EMAIL_REMETENTE=Kidmais Manager (staging) <nao-responda@mail.exemplo.invalid>
# RESEND_API_KEY=<segredo: chave só de envio, exclusiva de staging — colar no Render>

# --- Cadastro público (pré-requisitos do E1) ----------------------------------------------------------------------------
USUARIOS_CRIACAO_DIRETA=desativada
CADASTRO_PUBLICO_ATIVO=true
RECUPERACAO_SENHA_ATIVA=true
