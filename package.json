{
  "name": "kidmais-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "test:comercial:pagamento": "node --experimental-strip-types --test lib/comercial/condicao-pagamento.test.ts",
    "test:comercial:pagamento:integration": "node --env-file=.env.local scripts/condicao-pagamento.integration.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:disponibilidade": "node --experimental-strip-types --test lib/disponibilidade/services/horario.utils.test.ts",
    "test:contrato": "node --experimental-strip-types --test lib/contratos/services/snapshot-core.test.ts lib/contratos/documento/documento-core.test.ts lib/contratos/services/acesso-token.test.ts",
    "test:inteligencia": "node --experimental-strip-types --test lib/inteligencia/atencao-hoje.test.ts lib/inteligencia/gateway.test.ts lib/inteligencia/arquitetura.test.ts lib/inteligencia/jev/v1/jev-v1.test.ts lib/inteligencia/texto-modelo.test.ts lib/inteligencia/demerzel/demerzel.test.ts",
    "test:ia-demo": "node --experimental-strip-types --test components/admin/inteligencia/inteligencia-ui.test.ts components/admin/importacao/importacao.test.ts components/admin/importacao/seguranca-demo.test.ts",
    "test:pagamentos": "node --experimental-strip-types --test lib/pagamentos/services/financeiro-core.test.ts lib/pagamentos/services/idempotencia.test.ts",
    "test:pagamentos:integration": "node --env-file=.env.local scripts/pagamentos-engenharia.integration.cjs && node --env-file=.env.local scripts/pagamentos-http.integration.cjs && node --env-file=.env.local scripts/pagamentos-concorrencia.integration.cjs",
    "check:pagamentos:db": "node --env-file=.env.local scripts/pagamentos-inspecao.cjs",
    "check:v1:static": "node scripts/regressao-v1-estatica.cjs",
    "check:ia:prs": "node scripts/ia-composicao-prs.cjs && node scripts/ia-v1-pilha.cjs",
    "check:v1:postgres": "node scripts/regressao-v1-postgres.cjs",
    "check:v1:clone": "node scripts/regressao-v1-clone.cjs",
    "check:v1:staging": "node scripts/regressao-v1-staging.cjs",
    "check:v1:ui": "node scripts/festa-navegacao-ui.test.cjs",
    "check:v1:producao:readonly": "node --experimental-strip-types scripts/festa-016-preproducao-preservacao.cjs",
    "production:check": "node scripts/production/go-no-go.mjs",
    "production:check:json": "node scripts/production/go-no-go.mjs --json",
    "production:test": "node --test scripts/production/production.test.mjs"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
